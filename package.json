{
  "name": "gungnir-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "typecheck:tests": "tsc -p tsconfig.tests.json --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node apps/cli/dist/index.js",
    "check": "npm run lint && npm run build && npm run typecheck:tests && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
